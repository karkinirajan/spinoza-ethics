# Groq API key, used only by the server (app/api/explain). Never give it a NEXT_PUBLIC_ prefix: those variables are copied
# into the JavaScript every visitor downloads. Get one at https://console.groq.com/api-keys
GROQ_API_KEY=

# Optional. Set to true only behind a proxy you control that overwrites X-Forwarded-For (it is detected on Vercel).
TRUST_PROXY_HEADERS=
