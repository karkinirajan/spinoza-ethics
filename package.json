{
  "name": "spinoza-ethics-app",
  "version": "1.0.0",
  "description": "Interactive visual exploration of Baruch Spinoza's Ethics",
  "author": "kneeraazon",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run type-check && npm run lint && npm test",
    "ci": "npm run check && npm run build && npm audit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
